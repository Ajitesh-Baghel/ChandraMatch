# Python
.venv/
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/

# Raw / processed remote-sensing data
data/raw/
data/processed/

# Large geospatial / planetary files
*.IMG
*.img
*.cub
*.QUB
*.qub
*.zip
*.tar
*.tar.gz

# Large raster products
*.tif
*.tiff

# Model weights / caches
*.pth
*.pt
*.ckpt
*.onnx
.cache/

# Temporary experiment files
temp/
tmp/
*.tmp

# App runtime job artifacts (uploads + pipeline outputs)
app/jobs/

# Generated pipeline visualization outputs (overlay/checkerboard/preview PNGs
# under results/) -- large, fully regenerable from register()/the CLI
# scripts, not meant to be tracked. Curated illustrations under docs/images/
# are intentionally NOT covered by this rule.
results/**/*.png

# OS
Thumbs.db
.DS_Store
