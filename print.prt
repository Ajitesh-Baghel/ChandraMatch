Object = spiceinit
  IsisVersion       = "10.0.0  | 2026-08-26"
  AleVersion        = "1.2.0 | py313h7037e92_1"
  ProgramVersion    = 2021-08-10
  ProgramPath       = /home/ajitesh/miniforge3/envs/isis10.0.0/bin
  ExecutionDateTime = 2026-09-01T22:29:15
  HostName          = Unknown
  UserName          = ajitesh
  Description       = "Update SPICE data (kernels, pointing, and position) for
                       a camera cube"

  Group = UserParameters
    FROM         = data/processed/pair_004/lro_nac_isis/M185196277LE_raw.cub
    WEB          = yes
    ATTACH       = TRUE
    CKSMITHED    = FALSE
    CKRECON      = TRUE
    CKPREDICTED  = FALSE
    CKNADIR      = FALSE
    SPKSMITHED   = FALSE
    SPKRECON     = TRUE
    SPKPREDICTED = FALSE
    SHAPE        = SYSTEM
    STARTPAD     = 0.0
    ENDPAD       = 0.0
    URL          = https://astrogeology.usgs.gov/apis/ale/v0.9.1/spiceserver/
    PORT         = 443
  End_Group

  Group = Kernels
    NaifFrameCode             = -85600
    LeapSecond                = $base/kernels/lsk/naif0012.tls
    TargetAttitudeShape       = ($base/kernels/pck/pck00009.tpc,
                                 $lro/kernels/pck/moon_080317.tf,
                                 $lro/kernels/pck/moon_assoc_me.tf)
    TargetPosition            = (Table,
                                 $lro/kernels/tspk/moon_pa_de421_1900-2050.bpc,
                                 $lro/kernels/tspk/de421.bsp)
    InstrumentPointing        = (Table,
                                 $lro/kernels/ck/lrolc_2012060_2012092_v06.bc,
                                 $lro/kernels/ck/moc42r_2012060_2012092_v09.bc,
                                 $lro/kernels/fk/lro_frames_2014049_v01.tf)
    Instrument                = $lro/kernels/ik/lro_lroc_v20.ti
    SpacecraftClock           = $lro/kernels/sclk/lro_clkcor_2026238_v00.tsc
    InstrumentPosition        = (Table,
                                 $lro/kernels/spk/fdf29r_2012032_2012061_v01.b-
                                 sp)
    InstrumentAddendum        = $lro/kernels/iak/lro_instrumentAddendum_v05.ti
    ShapeModel                = $base/dems/ldem_128ppd_Mar2011_clon180_radius-
                                _pad.cub
    InstrumentPositionQuality = Reconstructed
    InstrumentPointingQuality = Reconstructed
    CameraVersion             = 2
  End_Group

  Group = Accounting
    ConnectTime = 00:00:22.5
    CpuTime     = 00:00:23.9
  End_Group
End_Object


